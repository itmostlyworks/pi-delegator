{
  "name": "pi-delegator",
  "version": "0.3.1",
  "description": "A small, reliability-first delegation extension for Pi",
  "license": "MIT",
  "author": "Ludwig Bäcklund",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludwigbacklund/pi-delegator.git"
  },
  "homepage": "https://github.com/ludwigbacklund/pi-delegator#readme",
  "bugs": {
    "url": "https://github.com/ludwigbacklund/pi-delegator/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "agents",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/node": "^22.19.19",
    "typebox": "^1.3.19",
    "typescript": "^5.9.3"
  }
}
